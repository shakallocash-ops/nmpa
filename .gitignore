# Dependencies (Vercel installs these from package.json)
node_modules/

# Next.js build output (Vercel builds this itself)
.next/
out/
dist/
build/
.vercel/

# Environment files - NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases
*.db
*.sqlite
*.sqlite3

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Archives / backups
*.zip
*.tar
*.gz
*.rar
*.7z

# TypeScript build info
*.tsbuildinfo

# Local uploads (admin-uploaded images stay local; production uses cloud storage)
public/uploads/*
!public/uploads/.gitkeep

# Local CMS data written at runtime
data/branding.json
